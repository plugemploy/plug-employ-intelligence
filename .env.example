# Copy this file to ".env" and fill in real values there.
# .env is never committed to Git. This example file is, so keep it free of real secrets.

# Local PostgreSQL database (Postgres.app). Replace YOUR_MAC_USERNAME.
DATABASE_URL=postgresql+psycopg://YOUR_MAC_USERNAME@localhost:5432/plug_employ_dev

# Added in later phases. Leave blank for now.
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
CLOSE_API_KEY=

# Monthly API spending cap for the prototype, in US dollars.
MONTHLY_API_BUDGET_USD=50

# Gmail connection (read-only). APP_SECRET_KEY encrypts stored Gmail access; generate your own.
APP_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APP_BASE_URL=http://127.0.0.1:8000

# Stripe billing. Use the TEST key (starts sk_test_) until launch.
STRIPE_SECRET_KEY=
